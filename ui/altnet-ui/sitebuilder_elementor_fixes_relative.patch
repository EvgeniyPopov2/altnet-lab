+  // Расширения:
+  anchorId?: string;
+  className?: string;
+  style?: { mt?: number; mb?: number; pt?: number; pb?: number; py?: number };
+  styleByBp?: {
+    desktop?: { mt?: number; mb?: number; pt?: number; pb?: number; py?: number };
+    tablet?: { mt?: number; mb?: number; pt?: number; pb?: number; py?: number };
