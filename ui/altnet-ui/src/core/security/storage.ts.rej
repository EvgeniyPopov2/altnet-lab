+const LS_KEY = "altnet.security.dismissed.v1";
+
+function safeParseJson<T>(raw: string | null): T | null {
+  if (!raw) return null;
+  try {
+    return JSON.parse(raw) as T;
+  } catch {
+    return null;
+  }
+}
+
+export function readDismissedKeys(): Set<string> {
+  if (typeof window === "undefined") return new Set();
+  const arr = safeParseJson<string[]>(window.localStorage.getItem(LS_KEY));
+  if (!Array.isArray(arr)) return new Set();
+  return new Set(arr.filter((x) => typeof x === "string" && x.length > 0));
+}
+
+export function writeDismissedKeys(keys: Set<string>): void {
+  if (typeof window === "undefined") return;
+  try {
+    window.localStorage.setItem(LS_KEY, JSON.stringify(Array.from(keys)));
+  } catch {
+    // fail-silent: не хотим ломать UI из-за quota/disabled storage
+  }
+}
+
+export function isDismissed(dedupeKey: string): boolean {
+  return readDismissedKeys().has(dedupeKey);
+}
+
+export function dismiss(dedupeKey: string): void {
+  const keys = readDismissedKeys();
+  keys.add(dedupeKey);
+  writeDismissedKeys(keys);
+}
+
+export function clearDismissedKeys(): void {
+  if (typeof window === "undefined") return;
+  try {
+    window.localStorage.removeItem(LS_KEY);
+  } catch {
+    // ignore
+  }
+}
