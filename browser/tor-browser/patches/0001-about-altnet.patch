+* { box-sizing: border-box; }
+:root { color-scheme: light dark; font-family: system-ui, sans-serif; }
+body { margin: 0; min-height: 100vh; color: #1c2340; background: #f5f6fc; }
+main { width: min(100% - 64px, 1050px); margin: 0 auto; padding: 32px 0 52px; }
+.topline, .brand, .section-heading, .actions { display: flex; align-items: center; }
+.topline, .section-heading { justify-content: space-between; gap: 16px; }
+.brand { gap: 10px; font-weight: 750; font-size: 17px; letter-spacing: -.02em; }
+.brand small { display: block; margin-top: 1px; color: #777e96; font-size: 9px; letter-spacing: .14em; }
+.mark { display: grid; place-items: center; width: 37px; height: 37px; }
+.mark img { display: block; width: 37px; height: 37px; }
+.badge { padding: 7px 11px; border: 1px solid #dfe2f0; border-radius: 999px; color: #6a718a; font-size: 11px; }
+.hero { margin-top: clamp(58px, 10vh, 112px); max-width: 760px; }
+.eyebrow { color: #725be1; font-size: 11px; font-weight: 750; letter-spacing: .13em; }
+h1 { margin: 15px 0 18px; font-size: clamp(31px, 5.4vw, 53px); letter-spacing: -.047em; line-height: 1.13; }
+h1 span { color: #7559ec; }
+.intro { max-width: 610px; color: #687089; font-size: 15px; line-height: 1.75; }
+.actions { flex-wrap: wrap; gap: 10px; margin-top: 27px; }
+button { color: inherit; font: inherit; cursor: pointer; }
+.primary, .secondary { display: inline-flex; justify-content: center; gap: 18px; padding: 12px 16px; border-radius: 11px; font-size: 13px; font-weight: 650; }
+.primary { border: 0; color: white; background: #7051e8; box-shadow: 0 7px 18px #6a4be534; }
+.primary:hover { background: #6040d5; }
+.secondary { border: 1px solid #dce0ed; background: #fff; }
+.secondary:hover, .tile:hover { border-color: #a696ed; }
+button:focus-visible { outline: 3px solid #a38cff; outline-offset: 3px; }
+.tools { margin-top: clamp(58px, 10vh, 100px); }
+.section-heading h2 { margin: 0; font-size: 15px; letter-spacing: -.01em; }
+.section-heading > span { color: #8990a5; font-size: 11px; }
+.grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12px; margin-top: 15px; }
+.tile { text-align: left; position: relative; display: flex; flex-direction: column; gap: 7px; min-height: 138px; padding: 18px; border: 1px solid #e1e4ef; border-radius: 15px; background: #fff; box-shadow: 0 6px 25px #242d5210; }
+.tile .icon { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; color: #7255e6; background: #f0ecff; font-size: 19px; }
+.tile strong { margin-top: 3px; font-size: 13px; }
+.tile > span:not(.icon) { color: #7b8299; font-size: 12px; line-height: 1.45; }
+.tile b { position: absolute; top: 17px; right: 18px; color: #9b9fb4; font-size: 13px; }
+.notice { display: flex; align-items: flex-start; gap: 10px; margin-top: 24px; padding: 13px 15px; border: 1px solid #e5e1f3; border-radius: 12px; color: #747188; background: #faf9ff; font-size: 11px; line-height: 1.55; }
+.notice p { margin: 0; }
+@media (prefers-color-scheme: dark) {
+ body { color: #f1f1ff; background: #101629; }
+ .brand small,.badge { color: #a2abc5; }
+ .badge { border-color: #34405f; }
+ .intro { color: #aab3ca; }
+ .secondary,.tile { background: #1a233b; border-color: #303b57; }
+ .secondary:hover,.tile:hover { border-color: #8d78ef; }
+ .tile { box-shadow: 0 6px 25px #0002; }
+ .tile .icon { color: #c3b7ff; background: #302954; }
+ .tile > span:not(.icon),.section-heading > span { color: #a1abc3; }
+ .notice { color: #b2bbd1; background: #191e34; border-color: #343a56; }
+}
+@media (max-width: 620px) {
+ main { width: min(100% - 36px, 1050px); padding-top: 20px; }
+ .badge { font-size: 10px; }
+ .hero { margin-top: 55px; }
+ .grid { grid-template-columns: 1fr; }
+ .tile { min-height: 112px; }
+ .section-heading > span { display: none; }
+}
