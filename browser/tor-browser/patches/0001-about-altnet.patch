+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+const ALLOWED_PANES = new Set(["general", "privacy", "search"]);
+
+export class AboutAltNetChild extends JSWindowActorChild {
+  handleEvent(event) {
+    if (!event.isTrusted || event.defaultPrevented || event.button !== 0) {
+      return;
+    }
+    const button = event.target.closest?.("button[data-altnet-setting]");
+    const pane = button?.dataset.altnetSetting;
+    if (
+      button?.ownerDocument.documentURI === "about:altnet" &&
+      ALLOWED_PANES.has(pane)
+    ) {
+      this.sendAsyncMessage("AboutAltNet:OpenPreferences", pane);
+    }
+  }
+}
diff --git a/browser/components/abouttor/AboutAltNetParent.sys.mjs b/browser/components/abouttor/AboutAltNetParent.sys.mjs
