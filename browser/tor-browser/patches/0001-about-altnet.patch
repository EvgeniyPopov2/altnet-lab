+.notice { display: flex; align-items: flex-start; gap: 10px; margin-top: 24px; padding: 13px 15px; border: 1px solid #e5e1f3; border-radius: 12px; color: #747188; background: #faf9ff; font-size: 11px; line-height: 1.55; }
+.notice p { margin: 0; }
+@media (prefers-color-scheme: dark) {
+ body { color: #f1f1ff; background: #101629; }
+ .brand small,.badge { color: #a2abc5; }
+ .badge { border-color: #34405f; }
+ .intro { color: #aab3ca; }
+ .secondary,.tile { background: #1a233b; border-color: #303b57; }
+ .secondary:hover,.tile:hover { border-color: #8d78ef; }
+ .tile { box-shadow: 0 6px 25px #0002; }
+ .tile .icon { color: #c3b7ff; background: #302954; }
+ .tile > span:not(.icon),.section-heading > span { color: #a1abc3; }
+ .notice { color: #b2bbd1; background: #191e34; border-color: #343a56; }
+}
+@media (max-width: 620px) {
+ main { width: min(100% - 36px, 1050px); padding-top: 20px; }
+ .badge { font-size: 10px; }
+ .hero { margin-top: 55px; }
+ .grid { grid-template-columns: 1fr; }
+ .tile { min-height: 112px; }
+ .section-heading > span { display: none; }
+}
