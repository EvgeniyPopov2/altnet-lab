diff --git a/browser/components/abouttor/content/aboutAltNet.css b/browser/components/abouttor/content/aboutAltNet.css
new file mode 100644
index 0000000000..52988665ca
--- /dev/null
+++ b/browser/components/abouttor/content/aboutAltNet.css
@@ -0,0 +1,12 @@
+* { box-sizing: border-box; }
+:root { color-scheme: light dark; font-family: system-ui, sans-serif; }
+body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; background: #f3f4fb; color: #1a2036; }
+main { width: min(100%, 560px); padding: clamp(28px, 6vw, 52px); border: 1px solid #e0e2ef; border-radius: 22px; background: #fff; box-shadow: 0 18px 60px #23204714; }
+.brand { color: #6b50eb; font-size: 14px; font-weight: 750; letter-spacing: .04em; }
+h1 { font-size: clamp(26px, 5vw, 38px); line-height: 1.15; margin: 22px 0 14px; }
+p { line-height: 1.6; color: #596078; }
+.primary { display: inline-block; margin-top: 18px; padding: 12px 18px; border-radius: 10px; background: #6b50eb; color: #fff; font-weight: 650; text-decoration: none; }
+.primary:hover { background: #5a40d6; }
+.primary:focus-visible { outline: 3px solid #aa9bff; outline-offset: 3px; }
+.hint { margin: 22px 0 0; font-size: 13px; }
+@media (prefers-color-scheme: dark) { body { background: #101629; color: #f4f4ff; } main { background: #192139; border-color: #303a56; box-shadow: 0 18px 60px #0004; } p { color: #b6bfd5; } .brand { color: #af9aff; } }
