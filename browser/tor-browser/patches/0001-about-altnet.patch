diff --git a/browser/components/about/test/unit/test_about_altnet.js b/browser/components/about/test/unit/test_about_altnet.js
new file mode 100644
index 0000000000..059fb664a1
--- /dev/null
+++ b/browser/components/about/test/unit/test_about_altnet.js
@@ -0,0 +1,9 @@
+const contract = "@mozilla.org/network/protocol/about;1?what=altnet";
+const aboutModule = Cc[contract].getService(Ci.nsIAboutModule);
+
+function run_test() {
+  const flags = aboutModule.getURIFlags(Services.io.newURI("about:altnet"));
+  ok(flags & Ci.nsIAboutModule.URI_SAFE_FOR_UNTRUSTED_CONTENT);
+  ok(flags & Ci.nsIAboutModule.URI_MUST_LOAD_IN_CHILD);
+  ok(!(flags & Ci.nsIAboutModule.ALLOW_SCRIPT));
+}
